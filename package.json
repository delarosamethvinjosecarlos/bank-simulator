{
  "name": "bbva-qa-test-environment",
  "version": "1.0.0",
  "description": "Entorno de pruebas para simular transferencias internacionales y tests E2E con Cypress",
  "main": "index.js",
  "scripts": {
    "start": "http-server . -p 8080 -c-1",
    "cy:open": "cypress open",
    "cy:headed": "cypress run --headed --no-exit --browser electron",
    "cy:chrome": "cypress run --headed --no-exit --browser chrome",
    "cy:run": "cypress run --browser electron",
    "dev": "start-server-and-test start http://127.0.0.1:8080 cy:open",
    "dev:visual": "start-server-and-test start http://127.0.0.1:8080 cy:headed",
    "dev:chrome": "start-server-and-test start http://127.0.0.1:8080 cy:chrome",
    "test": "start-server-and-test start http://127.0.0.1:8080 cy:run"
  },
  "devDependencies": {
    "cypress": "^13.13.0",
    "cypress-mochawesome-reporter": "^5.0.0",
    "http-server": "^14.1.1",
    "start-server-and-test": "^3.0.13"
  }
}
